# Build output. The bundle is generated by ./build-app.sh, including the icon and
# the patched copy of vpnc-script, so nothing in it is a source of truth.
AnywayConnect.app/
AnywayConnect.app.staging/
*.iconset/
*.icns
build/

# Distribution archives, left behind by scripts/notarize.sh and by release packaging.
*.zip
*.zip.sha256

# Runtime state. Lives under ~/.config/anyway-connect/ normally; this guards against
# a stray copy inside the checkout, which would mean committing tunnel logs and — if
# a connect were interrupted at the wrong moment — a live session cookie.
state/

# Agent / editor workspace
.kiro/

# macOS
.DS_Store
